# Next.js Portfolio - Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# ANTHROPIC CLAUDE API — Fallback when Gemini quota exhausted
# Get key at: https://console.anthropic.com/
# Free tier available: 5 requests/minute, limited tokens/day
# =============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# GOOGLE GEMINI API — Free tier, no billing required
# Get key at: https://aistudio.google.com/apikey
# Free tier limits: 10 RPM, 250K TPM, 1000 RPD (gemini-2.0-flash)
# =============================================================================
GOOGLE_API_KEY=your-gemini-api-key-here

# =============================================================================
# RAG — Cloudflare RAG worker (Vectorize + Workers AI; file-based KB is the fallback)
# Worker lives in workers/rag (`npx wrangler deploy`, secret RAG_KEY). Seed/refresh:
#   npx tsx scripts/seed-rag-cloudflare.ts
# =============================================================================
# CLOUDFLARE_RAG_WORKER_URL=https://lgportfolio-rag.your-subdomain.workers.dev
# CLOUDFLARE_RAG_KEY=your-rag-worker-shared-key

# =============================================================================
# INFERENCIA — Self-hosted OpenAI-compatible inference server (primary LLM)
# Powers the /chat AI assistant when your laptop/Mac is online.
# =============================================================================
INFERENCIA_API_KEY=your-inferencia-api-key-here
INFERENCIA_BASE_URL=http://localhost:8080/v1
INFERENCIA_CHAT_MODEL=gemma4:12b

# =============================================================================
# OPENROUTER — Cloud fallback when Inferencia is down (free models)
# Get key at: https://openrouter.ai/keys
# Chat tries Inferencia first (~18s), then OpenRouter free models automatically.
# Optional override: comma-separated model IDs (default list in src/lib/chat-providers.ts)
# =============================================================================
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_FALLBACK_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free

# =============================================================================
# CLOUDFLARE WORKERS AI — last-resort chat fallback (free 10k neurons/day)
# Routed through the RAG worker above (CLOUDFLARE_RAG_WORKER_URL + CLOUDFLARE_RAG_KEY).
# =============================================================================
# CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# =============================================================================
# LOCAL LLM FALLBACK — When main AI returns 429 (MLX server, OpenAI-compatible)
# Optional: set LOCAL_LLM_URL to override default http://localhost:11973/v1
# =============================================================================
# LOCAL_LLM_URL=http://localhost:11973/v1
# LOCAL_LLM_API_KEY=dummy

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
CHAT_MAX_RPM_PER_IP=3
CHAT_MAX_MESSAGES_PER_SESSION=20
CHAT_DAILY_BUDGET=900

# =============================================================================
# ANALYTICS — Google Analytics 4 (tag: portfolio, optional)
# =============================================================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# VISITOR-PRESENCE PINGS — Telegram message on likely-human site visits
# One ping per visitor per 30 min; bots/crawlers never ping; OWNER_IPS never
# ping (comma-separated; e.g. home + office IPs). Without these, no pings fire.
# =============================================================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# VISITOR_WEBHOOK_URL=
# OWNER_IPS=

# =============================================================================
# BUILD CONFIG
# =============================================================================
# Production (Vercel): set NEXT_PUBLIC_SITE_URL in the Vercel project to your custom domain (e.g. https://gimenez.dev).
NEXT_PUBLIC_SITE_URL=https://gimenez.dev

# =============================================================================
# OBSERVABILITY — Prometheus + Grafana (War Room aggregates from Prometheus)
# Prometheus scrapes GET /api/metrics with header X-Admin-Secret: <ADMIN_SECRET>
# =============================================================================
# PROMETHEUS_URL=http://localhost:9090
# PROMETHEUS_BEARER_TOKEN=
# PROMETHEUS_BASIC_AUTH=user:password
# NEXT_PUBLIC_GRAFANA_URL=https://grafana.example.com
# NEXT_PUBLIC_PROMETHEUS_URL=https://prometheus.example.com

# =============================================================================
# GCP (legacy Terraform — optional if not on Cloud Run)
# =============================================================================
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_REGION=us-east4

# =============================================================================
# FIREBASE / FIRESTORE — Chat session analytics & conversation memory
# Paste full service account JSON (single line or multiline). In production use
# Secret Manager and set FIREBASE_SERVICE_ACCOUNT_JSON from the secret.
# =============================================================================
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# =============================================================================
# ADMIN — Secret to view chat sessions at /admin/conversations
# =============================================================================
# ADMIN_SECRET=your-admin-secret-here
# Set on Vercel as encrypted env var, used by /api/metrics and /admin/* routes.
# Generate with: openssl rand -base64 32
# Pass as header: X-Admin-Secret: <secret> or Authorization: Bearer <secret>

# =============================================================================
# CHAT UI CONFIGURATION (optional)
# =============================================================================
# NEXT_PUBLIC_CHAT_MAX_MESSAGES=10

# =============================================================================
# ENGAGEMENT-BASED SESSION LIMITS (optional)
# =============================================================================
# CHAT_MAX_MESSAGES_PER_SESSION=10
# CHAT_ENGAGED_SESSION_LIMIT=25
# CHAT_ENGAGEMENT_THRESHOLD=5
