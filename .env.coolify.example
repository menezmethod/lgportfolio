# Coolify environment for gimenez.dev. Set these in the Coolify application (never commit real values).

# --- Chat: Cloudflare RAG worker (Vectorize retrieval + Workers AI generation) ---
CLOUDFLARE_RAG_WORKER_URL=https://lgportfolio-rag.your-subdomain.workers.dev
CLOUDFLARE_RAG_KEY=replace-with-worker-key

# --- App ---
ADMIN_SECRET=replace-with-admin-secret
NEXT_PUBLIC_SITE_URL=https://gimenez.dev
COOLIFY=1

# --- Optional: legacy and fallback chat providers (tried before Workers AI when set) ---
# INFERENCIA_BASE_URL=
# INFERENCIA_API_KEY=
# INFERENCIA_CHAT_MODEL=
# OPENROUTER_API_KEY=

# --- Optional: War Room reads Prometheus when this is set and reachable ---
# PROMETHEUS_URL=

# --- Rate limits (optional) ---
# CHAT_DAILY_BUDGET=150

# Visitor pings (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# VISITOR_WEBHOOK_URL=
